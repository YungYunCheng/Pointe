{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pointe-tenant",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "services": [
    {
      "binding": "BACKEND",
      "service": "pointe-backend"
    }
  ]
}
