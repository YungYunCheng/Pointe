# Copy to .env and fill in. .env is gitignored — keep it that way.

# --- database ---
POSTGRES_DB=baydo
POSTGRES_USER=baydo
# Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- api ---
SESSION_HOURS=12

# --- web ---
WEB_PORT=8080          # staff tools
TENANT_PORT=8081       # public site
PUBLIC_URL=http://localhost:8081

# --- AI. Server-side only: never expose this to the browser. ---
# Without it the AI tasks return 503 and every tool falls back to manual.
ANTHROPIC_API_KEY=

# --- email. Without it messages queue and are flagged, never silently dropped. ---
RESEND_API_KEY=
FROM_EMAIL=noreply@themizar.ca
FROM_NAME=Baydo Pointe

# --- SMS. Optional: without it, "both" falls back to email alone. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- links in outgoing messages ---
PUBLIC_URL=http://localhost:8080
PUBLIC_TENANT_URL=http://localhost:8081

# --- TLS. Run with: docker compose --profile tls up -d ---
DOMAIN=staff.example.com
TENANT_DOMAIN=www.example.com
ADMIN_EMAIL=admin@themizar.ca

# --- object storage. S3, R2, MinIO or Spaces. ---
# Evidence photographs and approved agreements. Local disk does not survive
# the container being replaced on another host.
S3_BUCKET=
S3_REGION=us-west-2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- shadow mode ---
# 1 = the AI runs the whole way through and nothing is sent. Two to four weeks
# of this before going live is how you measure the error rate.
AI_SHADOW_MODE=0
