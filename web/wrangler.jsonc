{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pointe-worker",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-10",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "services": [
    {
      "binding": "BACKEND",
      "service": "pointe-backend"
    }
  ]
}
