{
  "name": "baydo-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Baydo Pointe 租賃管理後端 — 權限、稽核、簽約鎖、車位併發、備份",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed.js",
    "reset": "node -e \"import('node:fs').then(f=>{try{f.unlinkSync('./data/baydo.db')}catch(e){};console.log('db removed')})\" && npm run seed"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "multer": "^1.4.5-lts.1"
  }
}
