{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pointe-backend",
  "main": "src/index.js",
  "compatibility_date": "2025-01-15",

  // Needed for the postgres driver and for anything reaching node: built-ins.
  // Without it the driver fails at import with a message that does not say why.
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Cloudflare-hosted multilingual model. No OpenAI key or always-on Python
  // server is required; env.AI runs on Cloudflare's serverless GPUs.
  "ai": { "binding": "AI" },

  // The same Worker answers on both hostnames. That is what removes CORS:
  // the staff site calls /api on its own domain, the tenant site calls /api
  // on its own domain, and neither is a cross-origin request.
  //
  // Without this the front ends would be on one domain and the API on
  // another, and every request would carry a preflight and a SameSite
  // problem for the session cookie.
  

  // Hyperdrive pools connections on Cloudflare's side. A Worker has no
  // long-lived process, so without it every request opens a new Postgres
  // connection and the database runs out long before the traffic does.
  //
  // Create it first:
  //   npx wrangler hyperdrive create pointe-db --connection-string="postgres://..."
  // then paste the id here.
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "1776a718ec8a4438a39b1d106733c4bb"
    }
  ],

  // Evidence photographs and approved agreements. These cannot be recreated,
  // and a Worker has no disk at all — R2 is not optional here the way it was
  // merely advisable on a container.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "pointe-files" }
  ],

  // Sessions and rate limiting. KV is eventually consistent, which is fine for
  // both: a session that takes a second to appear on another edge is not a
  // problem, and a rate limit that is briefly generous is not either.
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "b72235fac137474eb276182c99c8c7a3" }
  ],

  // What ran on setInterval in the container. Cron on Workers is UTC.
  // 07:00 UTC is midnight Mountain in summer, 23:00 the previous day in winter
  // — the jobs check the local date themselves rather than trusting the trigger.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "vars": {
    // The address messages come from. Its domain has to be one verified in
    // Resend — sending as @gmail.com is refused, because Gmail does not let
    // anybody send on its behalf.
    "FROM_EMAIL": "onboarding@resend.dev",
    "FROM_NAME": "Baydo Pointe",

    "ENVIRONMENT": "production",
    "WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "PUBLIC_URL": "https://pointe-worker.dcheng0726.workers.dev",
    "PUBLIC_TENANT_URL": "https://pointe.dcheng0726.workers.dev",
    "REPLY_TO_EMAIL": "rentals@themizar.ca"
  }

  // Secrets are not here. Set them with:
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put SESSION_PEPPER
  // Anything in vars is visible in the dashboard and in this file.
}
